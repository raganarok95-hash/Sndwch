node_modules/
test-results/
playwright-report/
dist/

# Herramientas de sesión (skills instaladas vía `npx skills add`, worktrees de Claude
# Code) — locales al entorno de trabajo, no forman parte de la app SND//WCH.
# Excepción: .claude/settings.json SÍ se commitea a propósito (hooks/permisos
# compartidos por todo el equipo/sesiones futuras, ver CLAUDE.md); todo lo demás en
# .claude/ (skills instaladas, settings.local.json, plans/) sigue siendo local.
.agents/
.claude/*
!.claude/settings.json
skills-lock.json
# Estado efímero de la skill impeccable (puerto/token de "modo live") — .impeccable/
# design.json y critique/ SÍ se commitean (son artefactos durables), esto no.
.impeccable/live/
deno.lock

# Cache de Python — se regenera en cada ejecución y cambia de nombre con cada versión del
# intérprete, así que ensucia todos los diffs. La regla era `modelo/__pycache__/` a secas
# porque hasta el 2026-09-10 los únicos .py del repo vivían ahí; desde que existen
# `scripts/tratar_fotos.py` y su chequeo, tiene que valer para todo el árbol.
__pycache__/
*.pyc

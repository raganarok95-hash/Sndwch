{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/nuevo/**/*.ts",
    "supabase/functions/_shared/esquema.ts",
    "supabase/functions/_shared/dominio.ts",
    "supabase/functions/_shared/contrato.ts",
    "supabase/functions/_shared/base.ts"
  ]
}
